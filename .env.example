# OpenClef — local development environment defaults
#
# Copy to .env and `docker compose up` will pick it up automatically:
#
#     cp .env.example .env
#     docker compose up -d
#
# .env is gitignored; .env.example is checked in. Anything in this file
# is intended for LOCAL DEVELOPMENT ONLY — never copy these values into a
# production deployment.

# --- First-run admin bootstrap -----------------------------------------
# These are read once at first boot to create the admin user. If a user
# already exists (i.e. on subsequent boots, or you've completed the
# /setup flow manually), they're ignored. Set BOTH or NEITHER — setting
# only one is silently ignored with a warning log.
#
# DEV CREDENTIALS — explicitly weak, do not reuse anywhere else.
OPENCLEF_ADMIN_USER=admin
OPENCLEF_ADMIN_PASSWORD=password

# --- Auth secrets ------------------------------------------------------
# Required for password hashing and session signing. The defaults below
# are recognisably non-secret so they never get mistaken for prod values.
# Production deployments MUST override these with high-entropy secrets.
OPENCLEF_PEPPER=dev-pepper-not-for-prod
OPENCLEF_SECRET_KEY=dev-secret-key-not-for-prod-min-32-chars-long-padding

# --- Optional: storage backend selection -------------------------------
# Default `local` writes uploads under /app/data inside the container.
# Set to `s3` and fill in the S3_* vars below to use an S3-compatible
# bucket (Garage, MinIO, B2, R2, AWS).
# OPENCLEF_STORAGE_BACKEND=local
# OPENCLEF_S3_BUCKET=
# OPENCLEF_S3_ENDPOINT=
# OPENCLEF_S3_REGION=us-east-1
# OPENCLEF_S3_ACCESS_KEY=
# OPENCLEF_S3_SECRET_KEY=
# OPENCLEF_S3_PATH_STYLE=false

# --- Misc --------------------------------------------------------------
# OPENCLEF_ENV=dev
# OPENCLEF_VERSION=dev
# OPENCLEF_THUMBNAIL_CACHE_MB=500
